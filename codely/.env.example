# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données (optionnel — sans DATABASE_URL, SQLite est utilisé)
DATABASE_URL=postgres://codequest:codequest@localhost:5432/codequest
POSTGRES_DB=codequest
POSTGRES_USER=codequest
POSTGRES_PASSWORD=codequest
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Superutilisateur (Docker entrypoint)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin1234
DJANGO_SUPERUSER_EMAIL=admin@codequest.app

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
