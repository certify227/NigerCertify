[Unit]
Description=WiFiZone Pro — Gunicorn (ASGI / WebSocket)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=exec
User=__WIFIZONE_USER__
Group=__WIFIZONE_GROUP__
WorkingDirectory=__BACKEND_DIR__
EnvironmentFile=__ENV_FILE__
Environment=DJANGO_SETTINGS_MODULE=config.settings
ExecStart=__VENV__/bin/gunicorn config.asgi:application \
  --bind 127.0.0.1:__APP_PORT__ \
  --workers __GUNICORN_WORKERS__ \
  --worker-class uvicorn.workers.UvicornWorker \
  --timeout 120 \
  --forwarded-allow-ips=* \
  --access-logfile - \
  --error-logfile -
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
