# Production — ne jamais commiter les valeurs réelles
# Copiez depuis: scripts/generate-secrets.sh

COMPOSE_PROJECT_NAME=wifizone_prod

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com
CORS_ALLOWED_ORIGINS=https://votre-domaine.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
ENABLE_API_DOCS=false
MIKROTIK_MOCK_MODE=false
FERNET_KEY=

CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

POSTGRES_DB=wifizone
POSTGRES_USER=wifizone
POSTGRES_PASSWORD=
DATABASE_URL=

REDIS_PASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CHANNEL_LAYER_URL=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@votre-domaine.com

NGINX_HOST=votre-domaine.com

# Chemin admin Django (optionnel — obscurcir /admin/)
DJANGO_ADMIN_URL=admin

# JWT production
JWT_ACCESS_HOURS=4
JWT_REFRESH_DAYS=7
