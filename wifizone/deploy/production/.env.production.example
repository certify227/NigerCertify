# Production — WiFiZone @ wifi.nigercertify.com
# Générez les secrets: ./scripts/generate-secrets.sh .env.production

COMPOSE_PROJECT_NAME=wifizone_prod

DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=wifi.nigercertify.com,www.wifi.nigercertify.com
CSRF_TRUSTED_ORIGINS=https://wifi.nigercertify.com,https://www.wifi.nigercertify.com
CORS_ALLOWED_ORIGINS=https://wifi.nigercertify.com,https://www.wifi.nigercertify.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
ENABLE_API_DOCS=false
MIKROTIK_MOCK_MODE=false
FERNET_KEY=

CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@nigercertify.com

POSTGRES_DB=wifizone
POSTGRES_USER=wifizone
POSTGRES_PASSWORD=
DATABASE_URL=

REDIS_PASSWORD=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CHANNEL_LAYER_URL=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.nigercertify.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@nigercertify.com

NGINX_HOST=wifi.nigercertify.com
DJANGO_ADMIN_URL=admin
JWT_ACCESS_HOURS=4
JWT_REFRESH_DAYS=7

# --- Nginx système (ports 8000-8003 déjà utilisés) ---
WIFIZONE_HOST_PORT=8004
ASGI_SERVER=gunicorn
GUNICORN_WORKERS=2
