# Niveau de log du renderer : debug | info | warn | error
# En développement, l'absence de valeur équivaut à debug.
VITE_LOG_LEVEL=info

# Nom affiché dans l'interface. Ne jamais placer d'identifiants IPTV ici.
VITE_APP_NAME=Aureon

# Niveau de log du processus Electron : debug | info | warn | error
AUREON_LOG_LEVEL=info

# Ouvre les outils de développement Electron uniquement si la valeur est 1.
AUREON_OPEN_DEVTOOLS=0
