{
  "manifestVersion": 5,
  "id": "com.creatorpack.photoshop",
  "name": "Creator Pack",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "26.0.0"
  },
  "entrypoints": [
    {
      "type": "command",
      "id": "reloadPlugin",
      "label": {
        "default": "Recharger Creator Pack",
        "fr": "Recharger Creator Pack"
      }
    },
    {
      "type": "panel",
      "id": "creatorPack",
      "label": {
        "default": "Creator Pack",
        "fr": "Creator Pack"
      },
      "minimumSize": { "width": 280, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 720 },
      "preferredFloatingSize": { "width": 340, "height": 760 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  }
}
